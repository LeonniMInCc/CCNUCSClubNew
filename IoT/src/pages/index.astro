---
import '../styles/global.css';
import { groups } from '../data/groups';
import { showcase } from '../data/showcase';
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="物联网协会 2026 招新：硬件、应用、算法，找到你的赛道。" />
    <title>物联网协会 · 2026 招新</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="物联网协会首页">
        <span class="brand-mark" aria-hidden="true">IO</span>
        <span>物联网协会</span>
      </a>
      <nav class="desktop-nav" aria-label="主要导航">
        <a href="#groups">三个组别</a>
        <a href="#showcase">荣誉与照片</a>
        <a href="#join">加入我们</a>
      </nav>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span>
        <span class="sr-only">打开菜单</span>
      </button>
      <nav id="mobile-nav" class="mobile-nav" aria-label="移动端导航">
        <a href="#groups">三个组别</a>
        <a href="#showcase">荣誉与照片</a>
        <a href="#join">加入我们</a>
      </nav>
    </header>

    <main id="top" class="scroll-stack">
      <section class="stack-layer hero" aria-labelledby="hero-title">
        <div class="hero-image" aria-hidden="true"></div>
        <div class="hero-overlay" aria-hidden="true"></div>
        <div class="hero-content reveal">
          <p class="eyebrow">2026 RECRUITMENT / IOT ASSOCIATION</p>
          <h1 id="hero-title">把世界<br /><em>连接</em>起来。</h1>
          <p class="hero-intro">三个方向，一起做出想法。<br />现在，选择你的方向。</p>
          <a class="scroll-cue" href="#groups"><span class="scroll-line"></span><span>向下探索</span></a>
        </div>
        <div class="hero-coordinates" aria-hidden="true"><span>22°17' N</span><span>113°34' E</span></div>
        <div class="hero-index" aria-hidden="true">01 <span>/</span> 03</div>
        <span class="layer-shade" aria-hidden="true"></span>
      </section>
      <section class="stack-layer intro-band" aria-label="协会简介">
        <div class="layer-inner reveal">
          <p class="section-label">/ THE ASSOCIATION</p>
          <p class="intro-copy">我们相信，最好的学习是在<br /><strong>一起解决问题</strong>的时候。</p>
          <p class="intro-note">从一块电路板，到一场比赛，<br />这里有同频的人，也有下一次出发。</p>
        </div>
        <span class="layer-shade" aria-hidden="true"></span>
      </section>

      <section id="groups" class="stack-layer groups-lead">
        <div class="layer-inner">
          <div class="groups-heading reveal">
            <p class="section-label">/ FIND YOUR LANE</p>
            <h2>三个组别，<br /><span>一条完整的链路。</span></h2>
          </div>
          <div class="group-nav" aria-label="组别导航">
            {groups.map((group) => <a href={`#${group.id}`}><span>{group.number}</span>{group.name}</a>)}
          </div>
        </div>
        <span class="layer-shade" aria-hidden="true"></span>
      </section>
      {groups.map((group, index) => (
        <article id={group.id} class:list={['stack-layer', 'group-panel', index % 2 === 1 && 'is-flipped']}>
          <div class="layer-inner">
            <div class="group-visual reveal">
              <img src={group.image} alt={group.imageAlt} loading="lazy" />
              <span class="visual-number">{group.number}</span>
              <span class="visual-caption">{group.kicker}</span>
            </div>
            <div class="group-info reveal">
              <p class="section-label">{group.number} / {group.kicker}</p>
              <h3>{group.name}</h3>
              <p class="group-description">{group.description}</p>
              <div class="info-grid">
                <div><p class="info-label">你会学到</p><ul>{group.learns.map((item) => <li>{item}</li>)}</ul></div>
                <div><p class="info-label">下一站</p><ul>{group.races.map((item) => <li>{item}</li>)}</ul></div>
              </div>
            </div>
          </div>
          <span class="layer-shade" aria-hidden="true"></span>
        </article>
      ))}

      <section id="showcase" class="stack-layer showcase-section">
        <div class="layer-inner">
          <div class="showcase-heading reveal">
            <p class="section-label">/ WHAT WE'VE MADE</p>
            <h2>荣誉与瞬间</h2>
          </div>
        </div>
        <div class="drift-viewport reveal">
          <div class="drift-track">
            {[...showcase, ...showcase].map((item) => (
              <figure class="drift-card">
                <img src={item.image} alt={item.imageAlt} loading="lazy" />
              </figure>
            ))}
          </div>
        </div>
        <span class="layer-shade" aria-hidden="true"></span>
      </section>

      <section id="join" class="stack-layer join-section" aria-labelledby="join-title">
        <div class="layer-inner reveal">
          <div>
            <p class="section-label">/ YOUR NEXT BUILD</p>
            <h2 id="join-title">准备好，<br /><em>了解</em>我们。</h2>
            <p class="join-copy">扫码加入群聊，咨询更多相关信息。</p>
          </div>
          <div class="qr-display">
            <img src="/assets/group-qr.png.jpg" alt="群聊二维码" />
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer"><span>物联网协会 / IOT ASSOCIATION</span><span>© 2026</span><span>KEEP CONNECTING</span></footer>

    <script>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealItems = document.querySelectorAll('.reveal');
      if (reducedMotion) revealItems.forEach((item) => item.classList.add('is-visible'));
      else {
        const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
        }), { threshold: 0.16 });
        revealItems.forEach((item) => observer.observe(item));
      }

      const menuToggle = document.querySelector('.menu-toggle');
      const mobileNav = document.querySelector('.mobile-nav');
      menuToggle?.addEventListener('click', () => {
        const open = menuToggle.getAttribute('aria-expanded') === 'true';
        menuToggle.setAttribute('aria-expanded', String(!open));
        mobileNav?.classList.toggle('is-open', !open);
      });
      mobileNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        menuToggle?.setAttribute('aria-expanded', 'false'); mobileNav.classList.remove('is-open');
      }));

      // Progressive shading: a pinned layer darkens as the next one slides over it.
      const layers = Array.from(document.querySelectorAll('.stack-layer'));
      let ticking = false;

      // A layer taller than the viewport must pin at a negative offset, otherwise the part
      // below the fold can never be scrolled into view while it is stuck.
      function measure() {
        layers.forEach((layer) => {
          layer.style.setProperty('--pin-top', '0px');
          const overflow = layer.offsetHeight - window.innerHeight;
          if (overflow > 0) layer.style.setProperty('--pin-top', `${-overflow}px`);
        });
      }

      function update() {
        ticking = false;
        if (reducedMotion) return;

        layers.forEach((layer, index) => {
          const next = layers[index + 1];
          if (!next) return void layer.style.setProperty('--shade', '0');
          // How far the next layer's top edge has travelled up across the viewport.
          const top = next.getBoundingClientRect().top;
          const covered = Math.min(1, Math.max(0, 1 - top / window.innerHeight));
          layer.style.setProperty('--shade', String((covered * 0.62).toFixed(3)));
        });
      }

      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }

      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', () => { measure(); onScroll(); });
      addEventListener('load', () => { measure(); update(); });
      // webfonts can change layer heights after first paint, which changes the pin offsets
      document.fonts?.ready.then(() => { measure(); update(); });
      measure();
      update();
    </script>
  </body>
</html>
